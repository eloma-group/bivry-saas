# ---------------------------------------------------------------------------
# BIVRY SaaS frontend
#
# Vite inlines every VITE_* variable into the bundle AT BUILD TIME. Nothing here
# is secret - anyone can read it in the shipped JavaScript - and nothing here can
# be changed after the build. Changing it means rebuilding and redeploying.
# ---------------------------------------------------------------------------

# Base URL of the BIVRY API, including the /api suffix, with no trailing slash.
#
# LOCAL:      leave unset. The app falls back to http://localhost:5000/api when
#             it is served from localhost.
# PRODUCTION: set it as the GitHub repository VARIABLE (not a secret) named
#             VITE_API_URL. .github/workflows/frontend.yml passes it to the
#             build and fails the run if it is missing.
#             Example: https://bivry-api.azurewebsites.net/api
VITE_API_URL=http://localhost:5000/api

# Google Maps browser key, for the address field suggestions.
#
# OPTIONAL. Unset, the address fields fall back to OpenStreetMap, which needs no
# key. Set, the fields suggest from Google Places instead. The key must have the
# Places API enabled with billing on, and should be restricted by HTTP referrer
# (it ships in the bundle, so it is public by design).
#
# LOCAL:      put it in frontend/.env.local (gitignored).
# PRODUCTION: set it as the GitHub repository VARIABLE named
#             VITE_GOOGLE_MAPS_API_KEY; the frontend workflow passes it to the
#             build.
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
