generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  phone               String?       @unique
  passwordHash        String        @map("password_hash")
  firstName           String        @map("first_name")
  lastName            String?       @map("last_name")
  avatarUrl           String?       @map("avatar_url")
  /// Super admins can manage other admins.
  isSuperAdmin        Boolean       @default(false) @map("is_super_admin")
  status              AccountStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  lastLoginAt         DateTime?     @map("last_login_at")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  @@index([status])
  @@map("admins")
}

model Customer {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  phone               String?       @unique
  passwordHash        String        @map("password_hash")
  firstName           String        @map("first_name")
  lastName            String?       @map("last_name")
  companyName         String?       @map("company_name")
  avatarUrl           String?       @map("avatar_url")
  status              AccountStatus @default(PENDING)
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  lastLoginAt         DateTime?     @map("last_login_at")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  @@index([status])
  @@map("customers")
}

model Vendor {
  id                     String               @id @default(uuid()) @db.Uuid
  email                  String               @unique
  phone                  String?              @unique
  passwordHash           String               @map("password_hash")
  companyName            String               @map("company_name")
  contactPerson          String?              @map("contact_person")
  abn                    String?              @map("abn")
  /// Australian Company Number, nine digits. Only a registered company has one,
  /// so a sole trader carries an ABN here and nothing in this column.
  acn                    String?              @map("acn")
  /// What the Business Register says about the ABN, in its own words:
  /// "Active from 24 Nov 2025". Filled by the lookup, never typed.
  abnStatus              String?              @map("abn_status")
  /// "Australian Private Company", "Individual/Sole Trader". Also from the
  /// register, and what says whether an ACN should exist at all.
  entityType             String?              @map("entity_type")
  /// Where the business stands on GST, in the register's own words:
  /// "Registered from 01 Jul 2000". Filled by the lookup, and correctable by
  /// hand for the rare business the register has nothing on.
  gst                    String?              @map("gst")
  logoUrl                String?              @map("logo_url")
  /// Human readable vendor reference (BIVRY-5000). Handed out by the server
  /// on the first onboarding load, never typed in.
  vendorCode             String?              @unique @map("vendor_code")
  /// The same reference under its old name, from when a vendor was called a
  /// supplier. Read by no code here any more, and still written, because a
  /// deployed build from before the rename reads it: migrations run ahead of
  /// the app and again on a rollback, so the column outlives the code by one
  /// release on purpose. Remove it, and this line, once no deployed build
  /// reads it - the same arrangement `tradingName` below is in.
  supplierId             String?              @unique @map("supplier_id")
  /// Superseded by `tradingNames`, and read by no code here any more. It is
  /// still written, and still declared, because a deployed build from before
  /// that change reads it: migrations run ahead of the app and again on a
  /// rollback, so the column outlives the code by one release on purpose.
  /// Remove it, and this line, once no deployed build reads it.
  tradingName            String?              @map("trading_name")
  /// Every name the business trades under. The Business Register lists them
  /// newest first and a company can hold several, so this is a list rather
  /// than the single name it used to be. The first is the one shown wherever
  /// only one will fit.
  tradingNames           String[]             @map("trading_names")
  legalName              String?              @map("legal_name")
  websiteAddress         String?              @map("website_address")
  /// Whether the billing address is a copy of the principal one. Stored so the
  /// tick comes back ticked; both rows are written out either way.
  billingSameAsPrincipal Boolean              @default(false) @map("billing_same_as_principal")
  /// The three invoice preference columns. The form stopped asking for these
  /// and no code here writes them any more, but they still hold what every
  /// vendor answered while it did, and a deployed build from before the change
  /// still reads them. Left in place for both reasons - the same arrangement
  /// `tradingName` above is in. Remove them, and these lines, once no deployed
  /// build reads them and the answers are no longer wanted.
  invoicePreference      String?              @map("invoice_preference")
  invoiceEmails          String[]             @map("invoice_emails")
  invoiceOther           String?              @map("invoice_other")
  status                 AccountStatus        @default(PENDING)
  onboardingStatus       OnboardingStatus     @default(NOT_STARTED) @map("onboarding_status")
  /// Index of the last completed onboarding step, used to resume the wizard.
  onboardingStep         Int                  @default(0) @map("onboarding_step")
  submittedAt            DateTime?            @map("submitted_at")
  approvedAt             DateTime?            @map("approved_at")
  rejectionReason        String?              @map("rejection_reason")
  emailVerifiedAt        DateTime?            @map("email_verified_at")
  lastLoginAt            DateTime?            @map("last_login_at")
  failedLoginAttempts    Int                  @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?            @map("locked_until")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  accreditation          VendorAccreditation?
  addresses              VendorAddress[]
  bankDetail             VendorBankDetail?
  contacts               VendorContact[]
  coverage               VendorCoverage?
  directors              VendorDirector[]
  documents              VendorDocument[]
  insurances             VendorInsurance[]
  warehouses             VendorWarehouse[]
  yards                  VendorYard[]

  @@index([status])
  @@index([onboardingStatus])
  @@map("vendors")
}

/// One contact block per department, as the vendor form asks for them.
///
/// The form only asks for the operations block and offers the other three as a
/// tick that copies it. There is no column for that tick: a copied block holds
/// details identical to the operations one, so the tick is read back off the
/// rows themselves. Storing it as well would be a second answer to a question
/// the data already answers, free to disagree with it.
model VendorContact {
  id            String            @id @default(uuid()) @db.Uuid
  vendorId      String            @map("vendor_id") @db.Uuid
  type          VendorContactType
  contactPerson String?           @map("contact_person")
  designation   String?
  contactNumber String?           @map("contact_number")
  email         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  vendor        Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@map("vendor_contacts")
}

/// Company C-suite. A vendor lists as many directors as it has.
model VendorDirector {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @map("vendor_id") @db.Uuid
  /// Keeps the rows in the order the vendor entered them.
  position      Int      @default(0)
  /// The director's full name, as it reads on the document naming them.
  name          String?
  /// Superseded by `name`: the form asks who the director is rather than what
  /// they are called in the company. Read by no code here any more, and no
  /// longer written, but still declared because a deployed build from before
  /// that change selects it. Remove it, and this line, once no deployed build
  /// reads it - the same arrangement `tradingName` is in.
  designation   String?
  email         String?
  contactNumber String?  @map("contact_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_directors")
}

model VendorBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @unique @map("vendor_id") @db.Uuid
  accountName   String?  @map("account_name")
  bankName      String?  @map("bank_name")
  bsb           String?
  accountNumber String?  @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_bank_details")
}

/// Where the vendor operates. Both columns hold several selections.
model VendorCoverage {
  id                 String   @id @default(uuid()) @db.Uuid
  vendorId           String   @unique @map("vendor_id") @db.Uuid
  areasCovered       String[] @map("areas_covered")
  businessOperations String[] @map("business_operations")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_coverages")
}

model VendorWarehouse {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  /// Keeps "Address 1", "Address 2" in the order they were entered.
  position  Int      @default(0)
  street1   String?
  street2   String?
  suburb    String?
  state     String?
  country   String?
  postCode  String?  @map("post_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_warehouses")
}

/// A yard: a site the vendor parks or stages at, kept apart from the
/// warehouses because it is not somewhere freight is collected from or
/// delivered to. Optional, and there can be several.
model VendorYard {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  /// Keeps "Yard 1", "Yard 2" in the order they were entered.
  position  Int      @default(0)
  street1   String?
  street2   String?
  suburb    String?
  state     String?
  country   String?
  postCode  String?  @map("post_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_yards")
}

/// The two addresses a vendor is registered at: where the business is run
/// from, and where its invoices go. A warehouse is a different thing - a site
/// freight moves through - and keeps its own table.
model VendorAddress {
  id        String            @id @default(uuid()) @db.Uuid
  vendorId  String            @map("vendor_id") @db.Uuid
  type      VendorAddressType
  street1   String?
  street2   String?
  suburb    String?
  state     String?
  country   String?
  postCode  String?           @map("post_code")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@map("vendor_addresses")
}

/// Certificate of accreditation. One per vendor, several expiry dates on it.
model VendorAccreditation {
  id                   String             @id @default(uuid()) @db.Uuid
  vendorId             String             @unique @map("vendor_id") @db.Uuid
  accreditationNumber  String?            @map("accreditation_number")
  /// When the accreditation itself lapses, as distinct from the scheme expiry
  /// dates below, which each belong to one module of it.
  expiryDate           DateTime?          @map("expiry_date") @db.Date
  massManagementExpiry DateTime?          @map("mass_management_expiry") @db.Date
  /// The form stopped asking for this one. Still declared and still holding
  /// what was answered while it did, because a deployed build from before that
  /// change selects it. Remove it, and this line, once no deployed build reads
  /// it - the same arrangement `tradingName` is in.
  basicFatigueExpiry   DateTime?          @map("basic_fatigue_expiry") @db.Date
  dangerousGoodsExpiry DateTime?          @map("dangerous_goods_expiry") @db.Date
  nhvasExpiry          DateTime?          @map("nhvas_expiry") @db.Date
  haccpExpiry          DateTime?          @map("haccp_expiry") @db.Date
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt           DateTime?          @map("verified_at")
  /// Admin id that verified this record (no FK - verifier may be admin or employee).
  verifiedBy           String?            @map("verified_by") @db.Uuid
  remarks              String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  vendor               Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_accreditations")
}

/// One row per policy the vendor holds. Work cover carries its own columns.
model VendorInsurance {
  id                 String              @id @default(uuid()) @db.Uuid
  vendorId           String              @map("vendor_id") @db.Uuid
  type               VendorInsuranceType
  policyNumber       String?             @map("policy_number")
  insurer            String?
  /// When the policy was issued. Asked for on every policy, work cover
  /// included, alongside whichever window that policy is keyed by.
  issueDate          DateTime?           @map("issue_date") @db.Date
  expiryDate         DateTime?           @map("expiry_date") @db.Date
  sumAssured         String?             @map("sum_assured")
  /// Work cover only: it is keyed by employer number and a validity window.
  employerNumber     String?             @map("employer_number")
  validFrom          DateTime?           @map("valid_from") @db.Date
  validTill          DateTime?           @map("valid_till") @db.Date
  dueInDays          Int?                @map("due_in_days")
  verificationStatus VerificationStatus  @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?           @map("verified_at")
  verifiedBy         String?             @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@map("vendor_insurances")
}

/// Every file a vendor uploads. `category` names the extra compliance rows
/// the vendor adds beyond the fixed list.
model VendorDocument {
  id          String             @id @default(uuid()) @db.Uuid
  vendorId    String             @map("vendor_id") @db.Uuid
  docType     VendorDocumentType @map("doc_type")
  category    String?
  /// Compliance documents carry both; the rest hold their dates on their section.
  issueDate   DateTime?          @map("issue_date") @db.Date
  expiryDate  DateTime?          @map("expiry_date") @db.Date
  fileName    String             @map("file_name")
  storageKey  String             @map("storage_key")
  storageUrl  String?            @map("storage_url")
  mimeType    String             @map("mime_type")
  sizeInBytes Int                @map("size_in_bytes")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  vendor      Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, docType])
  @@map("vendor_documents")
}

model Employee {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  phone               String?       @unique
  passwordHash        String        @map("password_hash")
  employeeCode        String?       @unique @map("employee_code")
  firstName           String        @map("first_name")
  lastName            String?       @map("last_name")
  department          String?
  designation         String?
  avatarUrl           String?       @map("avatar_url")
  status              AccountStatus @default(PENDING)
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  lastLoginAt         DateTime?     @map("last_login_at")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  @@index([status])
  @@map("employees")
}

model Driver {
  id                  String                    @id @default(uuid()) @db.Uuid
  email               String                    @unique
  phone               String?                   @unique
  passwordHash        String                    @map("password_hash")
  firstName           String                    @map("first_name")
  middleName          String?                   @map("middle_name")
  lastName            String?                   @map("last_name")
  dateOfBirth         DateTime?                 @map("date_of_birth") @db.Date
  /// The country on the driver's passport, held as the country itself -
  /// "Australia" - which is what the form has always offered. It was called
  /// `nationality`, which would be "Australian": a different word for a
  /// different thing, and never what was stored here.
  country             String?
  /// The same answer under that old name. Read by no code here any more, and
  /// still written, because a deployed build from before the rename reads it:
  /// migrations run ahead of the app and again on a rollback, so the column
  /// outlives the code by one release on purpose. Remove it, and this line,
  /// once no deployed build reads it.
  nationality         String?
  avatarUrl           String?                   @map("avatar_url")
  status              AccountStatus             @default(PENDING)
  onboardingStatus    OnboardingStatus          @default(NOT_STARTED) @map("onboarding_status")
  /// Index of the last completed onboarding step, used to resume the wizard.
  onboardingStep      Int                       @default(0) @map("onboarding_step")
  submittedAt         DateTime?                 @map("submitted_at")
  approvedAt          DateTime?                 @map("approved_at")
  rejectionReason     String?                   @map("rejection_reason")
  emailVerifiedAt     DateTime?                 @map("email_verified_at")
  lastLoginAt         DateTime?                 @map("last_login_at")
  failedLoginAttempts Int                       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?                 @map("locked_until")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  deletedAt           DateTime?                 @map("deleted_at")
  addresses           DriverAddress[]
  documents           DriverDocument[]
  drivingHistory      DriverDrivingHistory?
  drugTest            DriverDrugTest?
  licence             DriverLicence?
  medical             DriverMedical?
  medicare            DriverMedicare?
  passport            DriverPassport?
  policeVerification  DriverPoliceVerification?
  visa                DriverVisa?

  @@index([status])
  @@index([onboardingStatus])
  @@map("drivers")
}

model DriverAddress {
  id          String      @id @default(uuid()) @db.Uuid
  driverId    String      @map("driver_id") @db.Uuid
  type        AddressType
  houseNumber String?     @map("house_number")
  street      String?
  suburb      String?
  state       String?
  country     String?
  postCode    String?     @map("post_code")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
  @@map("driver_addresses")
}

model DriverLicence {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  licenceNumber      String?            @map("licence_number")
  licenceCardNumber  String?            @map("licence_card_number")
  licenceType        LicenceType?       @map("licence_type")
  issuingState       String?            @map("issuing_state")
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  /// Admin id that verified this record (no FK - verifier may be admin or employee).
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_licences")
}

model DriverDrivingHistory {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  issueDate          DateTime?          @map("issue_date") @db.Date
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_driving_histories")
}

model DriverPoliceVerification {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  issueDate          DateTime?          @map("issue_date") @db.Date
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_police_verifications")
}

model DriverVisa {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  visaStatus         String?            @map("visa_status")
  visaType           String?            @map("visa_type")
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_visas")
}

model DriverMedical {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  issueDate          DateTime?          @map("issue_date") @db.Date
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_medicals")
}

model DriverDrugTest {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  issueDate          DateTime?          @map("issue_date") @db.Date
  /// Always six months after the issue date - the form fills it in.
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_drug_tests")
}

/// Passport details. Asked of Australian nationals, who carry no visa.
model DriverPassport {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  passportNumber     String?            @map("passport_number")
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_passports")
}

/// Medicare card details. Asked of Australian nationals alongside the passport.
model DriverMedicare {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @unique @map("driver_id") @db.Uuid
  cardNumber         String?            @map("card_number")
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  driver             Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_medicares")
}

/// Every file a driver uploads. `category` is only used by ADDITIONAL docs.
model DriverDocument {
  id          String             @id @default(uuid()) @db.Uuid
  driverId    String             @map("driver_id") @db.Uuid
  docType     DriverDocumentType @map("doc_type")
  category    String?
  /// Only ADDITIONAL documents carry one: every other type has a section that
  /// holds its own expiry date.
  expiryDate  DateTime?          @map("expiry_date") @db.Date
  fileName    String             @map("file_name")
  storageKey  String             @map("storage_key")
  storageUrl  String?            @map("storage_url")
  mimeType    String             @map("mime_type")
  sizeInBytes Int                @map("size_in_bytes")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  driver      Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, docType])
  @@map("driver_documents")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  actorType ActorType @map("actor_type")
  actorId   String    @map("actor_id") @db.Uuid
  /// SHA-256 of the refresh token. The raw token is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  actorType   ActorType @map("actor_type")
  actorId     String    @map("actor_id") @db.Uuid
  /// SHA-256 of the reset token that was emailed to the user.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId])
  @@map("password_reset_tokens")
}

/// Audit trail of every login attempt, used for lockout and security review.
model LoginAttempt {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  email      String
  successful Boolean   @default(false)
  reason     String?
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorType, email])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Which login table an auth artifact (refresh token, reset token) belongs to.
enum ActorType {
  ADMIN
  CUSTOMER
  VENDOR
  EMPLOYEE
  DRIVER

  @@map("actor_type")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@map("onboarding_status")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED

  @@map("verification_status")
}

enum AddressType {
  CURRENT
  PERMANENT

  @@map("address_type")
}

/// Which of a vendor's two registered addresses a row holds.
enum VendorAddressType {
  PRINCIPAL
  BILLING

  @@map("vendor_address_type")
}

enum LicenceType {
  CAR
  HEAVY_RIGID
  HEAVY_COMBINATION
  MULTI_COMBINATION
  MOTORCYCLE

  @@map("licence_type")
}

enum DriverDocumentType {
  PROFILE_PHOTO
  LICENCE_FRONT
  LICENCE_BACK
  DRIVING_HISTORY
  POLICE_VERIFICATION
  VISA
  MEDICAL
  DRUG_TEST
  PASSPORT_FRONT
  PASSPORT_BACK
  MEDICARE
  ADDITIONAL

  @@map("driver_document_type")
}

/// The departments a vendor gives a contact for.
enum VendorContactType {
  OPERATIONS
  COMPLIANCE
  ADMIN
  DISPATCH

  @@map("vendor_contact_type")
}

enum VendorInsuranceType {
  PRODUCT_LIABILITY
  PUBLIC_LIABILITY
  WORK_COVER
  MARINE_GENERAL
  MARINE_ALCOHOL
  COC

  @@map("vendor_insurance_type")
}

/// Every slot holds a single file, except COMPLIANCE_ADDITIONAL, which is the
/// vendor's own extra rows and holds as many as they add.
enum VendorDocumentType {
  COMPANY_LOGO
  ACCREDITATION
  INSURANCE_PRODUCT_LIABILITY
  INSURANCE_PUBLIC_LIABILITY
  INSURANCE_WORK_COVER
  INSURANCE_MARINE_GENERAL
  INSURANCE_MARINE_ALCOHOL
  INSURANCE_COC
  COMPLIANCE_DRUG
  COMPLIANCE_ALCOHOL_POLICY
  COMPLIANCE_PROCEDURE
  COMPLIANCE_RISK_MANAGEMENT
  COMPLIANCE_SPEED_POLICY
  COMPLIANCE_FATIGUE_POLICY
  COMPLIANCE_GPS_SNAPSHOT
  COMPLIANCE_WHS_POLICY
  COMPLIANCE_ADDITIONAL

  @@map("vendor_document_type")
}
