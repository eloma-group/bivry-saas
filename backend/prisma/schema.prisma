// ---------------------------------------------------------------------------
// Bookings
//
// A booking raised in the Admin portal. It stands on its own set of tables and
// holds only ids for the customer and vendor it refers to (no relation, so the
// account models are left untouched), alongside a snapshot of the name shown at
// the time. Its pickups and deliveries are rows in booking_stops, its lanes in
// booking_lanes, and both prices - ours and the vendor's - are columns here.
// ---------------------------------------------------------------------------

model Booking {
  id                  String  @id @default(uuid()) @db.Uuid
  /// Human readable reference, BIVRY-<financial year>-<sequence>.
  jobNumber           String  @unique @map("job_number")
  /// The date the booking was received, as typed (YYYY-MM-DD).
  bookingReceivedDate String? @map("booking_received_date")
  /// Australian financial year the booking falls in, e.g. "26-27".
  financialYear       String? @map("financial_year")

  /// The chosen customer. Id only, plus a snapshot of the name and account
  /// number as they read when the booking was raised.
  customerId            String? @map("customer_id") @db.Uuid
  customerName          String? @map("customer_name")
  customerAccountNumber String? @map("customer_account_number")

  accountStatus   String? @map("account_status")
  agreementType   String? @map("agreement_type")
  reference       String?
  /// The invoice term, worded the way the accounts team words it: "Net 7".
  /// Filled from the customer's own billing term when one is picked, and left
  /// editable, so an admin can agree something else on a single booking.
  invoiceTerm     String? @map("invoice_term")
  cargoType       String? @map("cargo_type")
  vehicleType     String? @map("vehicle_type")
  trailerCategory String? @map("trailer_category")

  // Our price (AUD). The prices themselves are rows in booking_prices, one per
  // price column on the form; this is their totals added together, stored
  // rather than summed on read so a booking always quotes the figure the admin
  // actually saw when they saved it.
  priceFinalAmount Decimal? @map("price_final_amount") @db.Decimal(12, 2)

  // Vendor allotment and its own, separate price (AUD).
  vendorId             String?  @map("vendor_id") @db.Uuid
  vendorName           String?  @map("vendor_name")
  vendorGrossAmount    Decimal? @map("vendor_gross_amount") @db.Decimal(12, 2)
  /// The vendor's gross for the second trailer. That grid asks for a gross per
  /// trailer, because a load split across two is quoted as two figures, and the
  /// levy, GST and totals are all worked out from their sum. `vendorGrossAmount`
  /// above is trailer A. Our own price takes a single gross for the whole job,
  /// which is why there is no matching column for it.
  vendorGrossAmount2   Decimal? @map("vendor_gross_amount_2") @db.Decimal(12, 2)
  vendorFuelLevyPct    Decimal? @map("vendor_fuel_levy_pct") @db.Decimal(7, 2)
  vendorFuelLevyAmount Decimal? @map("vendor_fuel_levy_amount") @db.Decimal(12, 2)
  vendorGstPct         Decimal? @map("vendor_gst_pct") @db.Decimal(7, 2)
  vendorGstAmount      Decimal? @map("vendor_gst_amount") @db.Decimal(12, 2)
  vendorNetAmount      Decimal? @map("vendor_net_amount") @db.Decimal(12, 2)
  vendorTotalAmount    Decimal? @map("vendor_total_amount") @db.Decimal(12, 2)

  /// Admin id that raised the booking (no FK - a verifier may be an employee later).
  createdByAdminId String?   @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  stops  BookingStop[]
  lanes  BookingLane[]
  prices BookingPrice[]

  @@index([customerId])
  @@index([vendorId])
  @@index([financialYear])
  @@map("bookings")
}

/// A job number held for one admin while the Create Booking form is open.
///
/// Opening the form takes the next number and parks it here, so the admin can
/// see the number they are about to be given and no second admin is offered the
/// same one. Saving the booking consumes the row; closing the form releases it.
/// `expiresAt` is the backstop for a browser that never got to say either.
model BookingJobNumber {
  id            String   @id @default(uuid()) @db.Uuid
  jobNumber     String   @unique @map("job_number")
  financialYear String?  @map("financial_year")
  /// Admin the number is held for (no FK - a booking may be raised by an
  /// employee later, the same way `created_by_admin_id` allows for).
  adminId       String?  @map("admin_id") @db.Uuid
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("booking_job_numbers")
}

/// One pickup or delivery on a booking. The two share every field, so they are
/// one table split by `type` and ordered by `position`.
model BookingStop {
  id              String          @id @default(uuid()) @db.Uuid
  bookingId       String          @map("booking_id") @db.Uuid
  type            BookingStopType
  /// Order within its own kind: pickup 0, pickup 1, delivery 0, and so on.
  position        Int
  clientJobNumber String?         @map("client_job_number")
  trailer         String?
  /// When it is scheduled, as typed (YYYY-MM-DDTHH:mm).
  scheduledAt     String?         @map("scheduled_at")
  company         String?
  /// Unit, suite or flat number, kept apart from the street line so an address
  /// that has one reads "Suite 3" alongside "12 Balaclava Road" rather than
  /// both at once. Optional: plenty of addresses have none.
  suite           String?
  /// The street line, the way every other address in the product holds it:
  /// "12 Balaclava Road". It used to be one free `address` line alongside a
  /// `city`, which asked for the same address twice in two different shapes.
  street1         String?
  suburb          String?
  state           String?
  postCode        String?         @map("post_code")
  country         String?
  instructions    String?
  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_stops")
}

/// One price we charge the customer, in AUD.
///
/// A booking used to hold exactly one, as seven columns on the booking itself.
/// A booking that loads at two places is two things to charge for, so they are
/// rows here instead, ordered by `position` - the order the columns are shown
/// in on the form. The vendor's own price is unaffected and stays on the
/// booking: we agree one figure with a vendor for the job.
model BookingPrice {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  /// Order on the form, from 0. What makes "Gross Amount 2" the second one.
  position        Int
  grossAmount     Decimal? @map("gross_amount") @db.Decimal(12, 2)
  fuelLevyPct     Decimal? @map("fuel_levy_pct") @db.Decimal(7, 2)
  fuelLevyAmount  Decimal? @map("fuel_levy_amount") @db.Decimal(12, 2)
  gstPct          Decimal? @map("gst_pct") @db.Decimal(7, 2)
  gstAmount       Decimal? @map("gst_amount") @db.Decimal(12, 2)
  netAmount       Decimal? @map("net_amount") @db.Decimal(12, 2)
  totalAmount     Decimal? @map("total_amount") @db.Decimal(12, 2)
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_prices")
}

/// A lane worked out from a pickup/delivery pair: the trailer and the
/// "Pick-Up Suburb - Delivery Suburb" line, kept so a saved booking carries them.
model BookingLane {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  position  Int
  trailer   String?
  lane      String?
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_lanes")
}

enum BookingStopType {
  PICKUP
  DELIVERY

  @@map("booking_stop_type")
}

// ---------------------------------------------------------------------------
// Dropdown options
//
// Every dropdown in the product ships with a list written in the frontend's
// constants. A row here is one option somebody added from a form instead, kept
// so the next person to open that dropdown is offered it too.
//
// The built in lists stay in code: this table holds only the additions, and the
// two are merged when a field renders. Nothing reads a value back through this
// table - the answer a form stores is the text itself - so a row disappearing
// costs an option in the list and never a saved answer.
// ---------------------------------------------------------------------------

model OptionValue {
  id            String   @id @default(uuid()) @db.Uuid
  /// Which dropdown it belongs to, e.g. "booking.trailer". Named in
  /// `frontend/src/constants/optionLists.ts`, which is the only place that
  /// decides what a key means.
  listKey       String   @map("list_key")
  /// The option itself, stored and shown verbatim.
  value         String
  /// Who added it. No FK: any portal can add one, so this is the actor type and
  /// id the token carried, the same way the auth tables do it.
  createdByType String?  @map("created_by_type")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  /// One option per list. Case is settled in the service, so "Semi" and "semi"
  /// cannot both be added.
  @@unique([listKey, value])
  @@index([listKey])
  @@map("option_values")
}
