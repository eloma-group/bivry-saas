generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  phone               String?       @unique
  passwordHash        String        @map("password_hash")
  firstName           String        @map("first_name")
  lastName            String?       @map("last_name")
  avatarUrl           String?       @map("avatar_url")
  /// Super admins can manage other admins.
  isSuperAdmin        Boolean       @default(false) @map("is_super_admin")
  status              AccountStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  lastLoginAt         DateTime?     @map("last_login_at")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  @@index([status])
  @@map("admins")
}

model Customer {
  id                     String                      @id @default(uuid()) @db.Uuid
  email                  String                      @unique
  phone                  String?                     @unique
  passwordHash           String                      @map("password_hash")
  /// Human readable customer reference (CAN5000). Assigned by the server when
  /// the account is created and never typed in; the booking form reads it back.
  accountNumber          String?                     @unique @map("account_number")
  /// The customer identifier the rest of the product quotes (BIVCST5000 onwards).
  /// Handed out by the server on the first onboarding load, never typed in, and
  /// what a customer is looked up by outside this module.
  cid                    String?                     @unique
  firstName              String                      @map("first_name")
  lastName               String?                     @map("last_name")
  companyName            String?                     @map("company_name")
  /// What the person named above does at the company: CEO, Director, and so on.
  designation            String?
  /// Every name the business trades under, newest first as the Business
  /// Register lists them. The first is the one shown wherever only one fits.
  tradingNames           String[]                    @map("trading_names")
  legalName              String?                     @map("legal_name")
  abn                    String?
  /// Australian Company Number, nine digits. Only a registered company has one.
  acn                    String?
  /// What the Business Register says about the ABN, in its own words.
  abnStatus              String?                     @map("abn_status")
  entityType             String?                     @map("entity_type")
  gst                    String?
  websiteAddress         String?                     @map("website_address")
  /// The day the customer record was opened, as the form asks for it. Defaults
  /// to today in the form and can be changed, so it is not `created_at`.
  creationDate           DateTime?                   @map("creation_date") @db.Date
  avatarUrl              String?                     @map("avatar_url")
  logoUrl                String?                     @map("logo_url")
  /// Whether the billing address is a copy of the principal one. Stored so the
  /// tick comes back ticked; both rows are written out either way.
  billingSameAsPrincipal Boolean                     @default(false) @map("billing_same_as_principal")
  status                 AccountStatus               @default(PENDING)
  onboardingStatus       OnboardingStatus            @default(NOT_STARTED) @map("onboarding_status")
  /// Index of the last completed onboarding step, used to resume the wizard.
  onboardingStep         Int                         @default(0) @map("onboarding_step")
  submittedAt            DateTime?                   @map("submitted_at")
  approvedAt             DateTime?                   @map("approved_at")
  rejectionReason        String?                     @map("rejection_reason")
  emailVerifiedAt        DateTime?                   @map("email_verified_at")
  lastLoginAt            DateTime?                   @map("last_login_at")
  failedLoginAttempts    Int                         @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?                   @map("locked_until")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  deletedAt              DateTime?                   @map("deleted_at")
  addresses              CustomerAddress[]
  additionalContacts     CustomerAdditionalContact[]
  billing                CustomerBilling?
  contacts               CustomerContact[]
  directors              CustomerDirector[]
  documents              CustomerDocument[]
  warehouses             CustomerWarehouse[]

  @@index([status])
  @@index([onboardingStatus])
  @@map("customers")
}

/// One contact block per department, as the customer form asks for them.
///
/// The form only asks for the operations block and offers the other three as a
/// tick that copies it. There is no column for that tick: a copied block holds
/// details identical to the operations one, so the tick is read back off the
/// rows themselves rather than stored a second time where it could disagree.
model CustomerContact {
  id            String              @id @default(uuid()) @db.Uuid
  customerId    String              @map("customer_id") @db.Uuid
  type          CustomerContactType
  contactPerson String?             @map("contact_person")
  designation   String?
  contactNumber String?             @map("contact_number")
  email         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@map("customer_contacts")
}

/// A contact block the customer added themselves, beyond the four departments
/// above.
///
/// A table of its own rather than a fifth enum value on `customer_contacts`:
/// that table holds one row per department and says so with a unique index, and
/// a customer can add as many of these as they like. Kept apart, a build from
/// before this change goes on reading the four departments unchanged and simply
/// does not see the extra ones.
model CustomerAdditionalContact {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  /// Keeps the rows in the order the customer entered them.
  position      Int      @default(0)
  /// What this block is for, in the customer's own words: "Legal", "After
  /// hours". The equivalent of the department name on a fixed block.
  label         String?
  contactPerson String?  @map("contact_person")
  designation   String?
  contactNumber String?  @map("contact_number")
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_additional_contacts")
}

/// A warehouse the customer operates: a site we may collect from or deliver to.
///
/// The same shape the vendor's warehouses have, and separate from
/// `customer_addresses` for the same reason: that table holds the two addresses
/// the company is registered at, one row each, and there can be any number of
/// these.
model CustomerWarehouse {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  /// Keeps "Warehouse 1", "Warehouse 2" in the order they were entered.
  position   Int      @default(0)
  /// Unit, suite or flat number, kept apart from the street line so an address
  /// that has one reads "Suite 3" alongside "12 Balaclava Road" rather than
  /// both at once. Optional: plenty of addresses have none.
  suite      String?
  street1    String?
  street2    String?
  suburb     String?
  state      String?
  country    String?
  postCode   String?  @map("post_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_warehouses")
}

/// The customer's directors. As many as the business has.
model CustomerDirector {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  /// Keeps the rows in the order the customer entered them.
  position      Int      @default(0)
  /// Full name, as it reads on the document naming them.
  name          String?
  designation   String?
  email         String?
  contactNumber String?  @map("contact_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_directors")
}

/// The two addresses a customer is registered at: where the business is run
/// from, and where its invoices go.
model CustomerAddress {
  id         String              @id @default(uuid()) @db.Uuid
  customerId String              @map("customer_id") @db.Uuid
  type       CustomerAddressType
  /// Unit, suite or flat number, kept apart from the street line so an address
  /// that has one reads "Suite 3" alongside "12 Balaclava Road" rather than
  /// both at once. Optional: plenty of addresses have none.
  suite      String?
  street1    String?
  street2    String?
  suburb     String?
  state      String?
  country    String?
  postCode   String?             @map("post_code")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@map("customer_addresses")
}

/// How the customer is billed: the payment term, and whether they are invoiced
/// or run on RCTI. One row per customer.
model CustomerBilling {
  id          String               @id @default(uuid()) @db.Uuid
  customerId  String               @unique @map("customer_id") @db.Uuid
  /// The payment term as the accounts team words it: "Net 30".
  term        String?
  billingType CustomerBillingType? @map("billing_type")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_billings")
}

/// Every file a customer uploads. `category` names the extra document rows the
/// customer adds beyond the two fixed slots.
model CustomerDocument {
  id          String               @id @default(uuid()) @db.Uuid
  customerId  String               @map("customer_id") @db.Uuid
  docType     CustomerDocumentType @map("doc_type")
  category    String?
  issueDate   DateTime?            @map("issue_date") @db.Date
  expiryDate  DateTime?            @map("expiry_date") @db.Date
  fileName    String               @map("file_name")
  storageKey  String               @map("storage_key")
  storageUrl  String?              @map("storage_url")
  mimeType    String               @map("mime_type")
  sizeInBytes Int                  @map("size_in_bytes")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, docType])
  @@map("customer_documents")
}

model Vendor {
  id                     String               @id @default(uuid()) @db.Uuid
  email                  String               @unique
  phone                  String?              @unique
  passwordHash           String               @map("password_hash")
  companyName            String               @map("company_name")
  contactPerson          String?              @map("contact_person")
  abn                    String?              @map("abn")
  /// Australian Company Number, nine digits. Only a registered company has one,
  /// so a sole trader carries an ABN here and nothing in this column.
  acn                    String?              @map("acn")
  /// What the Business Register says about the ABN, in its own words:
  /// "Active from 24 Nov 2025". Filled by the lookup, never typed.
  abnStatus              String?              @map("abn_status")
  /// "Australian Private Company", "Individual/Sole Trader". Also from the
  /// register, and what says whether an ACN should exist at all.
  entityType             String?              @map("entity_type")
  /// Where the business stands on GST, in the register's own words:
  /// "Registered from 01 Jul 2000". Filled by the lookup, and correctable by
  /// hand for the rare business the register has nothing on.
  gst                    String?              @map("gst")
  logoUrl                String?              @map("logo_url")
  /// Human readable vendor reference (BIVRY-5000). Handed out by the server
  /// on the first onboarding load, never typed in.
  vendorCode             String?              @unique @map("vendor_code")
  /// Every name the business trades under. The Business Register lists them
  /// newest first and a company can hold several, so this is a list rather
  /// than the single name it used to be. The first is the one shown wherever
  /// only one will fit.
  tradingNames           String[]             @map("trading_names")
  legalName              String?              @map("legal_name")
  websiteAddress         String?              @map("website_address")
  /// Whether the billing address is a copy of the principal one. Stored so the
  /// tick comes back ticked; both rows are written out either way.
  billingSameAsPrincipal Boolean              @default(false) @map("billing_same_as_principal")
  status                 AccountStatus        @default(PENDING)
  onboardingStatus       OnboardingStatus     @default(NOT_STARTED) @map("onboarding_status")
  /// Index of the last completed onboarding step, used to resume the wizard.
  onboardingStep         Int                  @default(0) @map("onboarding_step")
  submittedAt            DateTime?            @map("submitted_at")
  approvedAt             DateTime?            @map("approved_at")
  rejectionReason        String?              @map("rejection_reason")
  emailVerifiedAt        DateTime?            @map("email_verified_at")
  lastLoginAt            DateTime?            @map("last_login_at")
  failedLoginAttempts    Int                  @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?            @map("locked_until")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  accreditation          VendorAccreditation?
  addresses              VendorAddress[]
  bankDetail             VendorBankDetail?
  contacts               VendorContact[]
  coverage               VendorCoverage?
  directors              VendorDirector[]
  documents              VendorDocument[]
  insurances             VendorInsurance[]
  warehouses             VendorWarehouse[]
  yards                  VendorYard[]

  @@index([status])
  @@index([onboardingStatus])
  @@map("vendors")
}

/// One contact block per department, as the vendor form asks for them.
///
/// The form only asks for the operations block and offers the other three as a
/// tick that copies it. There is no column for that tick: a copied block holds
/// details identical to the operations one, so the tick is read back off the
/// rows themselves. Storing it as well would be a second answer to a question
/// the data already answers, free to disagree with it.
model VendorContact {
  id            String            @id @default(uuid()) @db.Uuid
  vendorId      String            @map("vendor_id") @db.Uuid
  type          VendorContactType
  contactPerson String?           @map("contact_person")
  designation   String?
  contactNumber String?           @map("contact_number")
  email         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  vendor        Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@map("vendor_contacts")
}

/// Company C-suite. A vendor lists as many directors as it has.
model VendorDirector {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @map("vendor_id") @db.Uuid
  /// Keeps the rows in the order the vendor entered them.
  position      Int      @default(0)
  /// The director's full name, as it reads on the document naming them.
  name          String?
  email         String?
  contactNumber String?  @map("contact_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_directors")
}

model VendorBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @unique @map("vendor_id") @db.Uuid
  accountName   String?  @map("account_name")
  bankName      String?  @map("bank_name")
  bsb           String?
  accountNumber String?  @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_bank_details")
}

/// Where the vendor operates. Both columns hold several selections.
model VendorCoverage {
  id                 String   @id @default(uuid()) @db.Uuid
  vendorId           String   @unique @map("vendor_id") @db.Uuid
  areasCovered       String[] @map("areas_covered")
  businessOperations String[] @map("business_operations")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_coverages")
}

model VendorWarehouse {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  /// Keeps "Address 1", "Address 2" in the order they were entered.
  position  Int      @default(0)
  /// Unit, suite or flat number, kept apart from the street line so an address
  /// that has one reads "Suite 3" alongside "12 Balaclava Road" rather than
  /// both at once. Optional: plenty of addresses have none.
  suite     String?
  street1   String?
  street2   String?
  suburb    String?
  state     String?
  country   String?
  postCode  String?  @map("post_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_warehouses")
}

/// A yard: a site the vendor parks or stages at, kept apart from the
/// warehouses because it is not somewhere freight is collected from or
/// delivered to. Optional, and there can be several.
model VendorYard {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  /// Keeps "Yard 1", "Yard 2" in the order they were entered.
  position  Int      @default(0)
  /// Unit, suite or flat number, kept apart from the street line so an address
  /// that has one reads "Suite 3" alongside "12 Balaclava Road" rather than
  /// both at once. Optional: plenty of addresses have none.
  suite     String?
  street1   String?
  street2   String?
  suburb    String?
  state     String?
  country   String?
  postCode  String?  @map("post_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_yards")
}

/// The two addresses a vendor is registered at: where the business is run
/// from, and where its invoices go. A warehouse is a different thing - a site
/// freight moves through - and keeps its own table.
model VendorAddress {
  id        String            @id @default(uuid()) @db.Uuid
  vendorId  String            @map("vendor_id") @db.Uuid
  type      VendorAddressType
  /// Unit, suite or flat number, kept apart from the street line so an address
  /// that has one reads "Suite 3" alongside "12 Balaclava Road" rather than
  /// both at once. Optional: plenty of addresses have none.
  suite     String?
  street1   String?
  street2   String?
  suburb    String?
  state     String?
  country   String?
  postCode  String?           @map("post_code")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@map("vendor_addresses")
}

/// Certificate of accreditation. One per vendor, several expiry dates on it.
model VendorAccreditation {
  id                   String             @id @default(uuid()) @db.Uuid
  vendorId             String             @unique @map("vendor_id") @db.Uuid
  accreditationNumber  String?            @map("accreditation_number")
  /// When the accreditation itself lapses, as distinct from the scheme expiry
  /// dates below, which each belong to one module of it.
  expiryDate           DateTime?          @map("expiry_date") @db.Date
  massManagementExpiry DateTime?          @map("mass_management_expiry") @db.Date
  dangerousGoodsExpiry DateTime?          @map("dangerous_goods_expiry") @db.Date
  nhvasExpiry          DateTime?          @map("nhvas_expiry") @db.Date
  haccpExpiry          DateTime?          @map("haccp_expiry") @db.Date
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt           DateTime?          @map("verified_at")
  /// Admin id that verified this record (no FK - verifier may be admin or employee).
  verifiedBy           String?            @map("verified_by") @db.Uuid
  remarks              String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  vendor               Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_accreditations")
}

/// One row per policy the vendor holds. Work cover carries its own columns.
model VendorInsurance {
  id                 String              @id @default(uuid()) @db.Uuid
  vendorId           String              @map("vendor_id") @db.Uuid
  type               VendorInsuranceType
  policyNumber       String?             @map("policy_number")
  insurer            String?
  /// When the policy was issued. Asked for on every policy, work cover
  /// included, alongside whichever window that policy is keyed by.
  issueDate          DateTime?           @map("issue_date") @db.Date
  expiryDate         DateTime?           @map("expiry_date") @db.Date
  sumAssured         String?             @map("sum_assured")
  /// Work cover only: it is keyed by employer number and a validity window.
  employerNumber     String?             @map("employer_number")
  validFrom          DateTime?           @map("valid_from") @db.Date
  validTill          DateTime?           @map("valid_till") @db.Date
  dueInDays          Int?                @map("due_in_days")
  verificationStatus VerificationStatus  @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?           @map("verified_at")
  verifiedBy         String?             @map("verified_by") @db.Uuid
  remarks            String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@map("vendor_insurances")
}

/// Every file a vendor uploads. `category` names the extra compliance rows
/// the vendor adds beyond the fixed list.
model VendorDocument {
  id          String             @id @default(uuid()) @db.Uuid
  vendorId    String             @map("vendor_id") @db.Uuid
  docType     VendorDocumentType @map("doc_type")
  category    String?
  /// Compliance documents carry both; the rest hold their dates on their section.
  issueDate   DateTime?          @map("issue_date") @db.Date
  expiryDate  DateTime?          @map("expiry_date") @db.Date
  fileName    String             @map("file_name")
  storageKey  String             @map("storage_key")
  storageUrl  String?            @map("storage_url")
  mimeType    String             @map("mime_type")
  sizeInBytes Int                @map("size_in_bytes")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  vendor      Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, docType])
  @@map("vendor_documents")
}

model Employee {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  phone               String?       @unique
  passwordHash        String        @map("password_hash")
  employeeCode        String?       @unique @map("employee_code")
  firstName           String        @map("first_name")
  lastName            String?       @map("last_name")
  department          String?
  designation         String?
  avatarUrl           String?       @map("avatar_url")
  status              AccountStatus @default(PENDING)
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  lastLoginAt         DateTime?     @map("last_login_at")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  @@index([status])
  @@map("employees")
}

model Driver {
  id                  String                    @id @default(uuid()) @db.Uuid
  email               String                    @unique
  phone               String?                   @unique
  passwordHash        String                    @map("password_hash")
  firstName           String                    @map("first_name")
  middleName          String?                   @map("middle_name")
  lastName            String?                   @map("last_name")
  dateOfBirth         DateTime?                 @map("date_of_birth") @db.Date
  /// The country on the driver's passport, held as the country itself -
  /// "Australia", not "Australian".
  country             String?
  avatarUrl           String?                   @map("avatar_url")
  status              AccountStatus             @default(PENDING)
  onboardingStatus    OnboardingStatus          @default(NOT_STARTED) @map("onboarding_status")
  /// Index of the last completed onboarding step, used to resume the wizard.
  onboardingStep      Int                       @default(0) @map("onboarding_step")
  submittedAt         DateTime?                 @map("submitted_at")
  approvedAt          DateTime?                 @map("approved_at")
  rejectionReason     String?                   @map("rejection_reason")
  emailVerifiedAt     DateTime?                 @map("email_verified_at")
  lastLoginAt         DateTime?                 @map("last_login_at")
  failedLoginAttempts Int                       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?                 @map("locked_until")
