# ---------------------------------------------------------------------------
# BIVRY SaaS backend
#
# LOCAL:      copy this file to backend/.env and fill in real values.
# PRODUCTION: do NOT ship a .env file. Every key below becomes an
#             Application Setting on the Azure App Service, where it arrives as
#             a normal environment variable. See DEPLOYMENT.md step 6.
# ---------------------------------------------------------------------------

NODE_ENV=development

# App Service injects its own PORT and ignores this. Local only.
PORT=5000

# ---------------------------------------------------------------------------
# Frontend origin
#
# Used for two things: the CORS allow list, and the host in password reset
# links. Production must be the Static Web App URL (or your custom domain),
# with NO trailing slash. Getting this wrong is the most common cause of
# "login works locally but not on Azure".
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# Extra allowed origins, comma separated. Static Web Apps serves pull request
# previews from their own hostnames, so add them here rather than above.
# CORS_EXTRA_ORIGINS=https://bivry-dashboard-staging.azurestaticapps.net

# ---------------------------------------------------------------------------
# Database - Azure Database for PostgreSQL (Flexible Server)
#
# Azure requires TLS, so keep ?sslmode=require.
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
# The username is plain (RJ), not RJ@bivry.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://RJ:%23Bivry%40100%25@bivry.postgres.database.azure.com:5432/bivry-db?sslmode=require

# Add once the App Service scales beyond one instance. A burstable Postgres tier
# allows very few connections and every instance opens its own pool.
# DATABASE_URL="...?sslmode=require&connection_limit=5&pool_timeout=20"

# ---------------------------------------------------------------------------
# JWT
#
# Generate each one separately, never reuse the same value for both:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Rotating these logs every user out, which is the point if one ever leaks.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Account lockout after repeated failed logins
# ---------------------------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Self service signup per role.
#
# Admin and employee accounts are not self service. Admins are created with
#   cd backend && npx tsx scripts/create-admin.ts --email you@company.com --password '...'
# by whoever holds DATABASE_URL, and then sign in. The frontend does not mount
# /admin/register either (see PORTALS.admin.selfSignup), so turning this on would
# only expose the API endpoint to strangers.
# ---------------------------------------------------------------------------
ALLOW_ADMIN_SIGNUP=false
ALLOW_EMPLOYEE_SIGNUP=false
ALLOW_CUSTOMER_SIGNUP=true
ALLOW_VENDOR_SIGNUP=true
ALLOW_DRIVER_SIGNUP=true

# ---------------------------------------------------------------------------
# File storage - Azure Blob Storage
#
# Leave the connection string blank locally and uploads go to backend/uploads.
# In production it is REQUIRED: the App Service filesystem is ephemeral, so a
# file written to disk is gone on the next restart, deploy or scale event. The
# server refuses to boot in production without it.
#
# Copy the connection string from:
#   Storage account > Security + networking > Access keys > Connection string
# Either key works. Keep the other one as the spare for zero downtime rotation.
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
# One container per area, so driver, supplier and admin files stay separate.
AZURE_STORAGE_CONTAINER=driver-documents
AZURE_STORAGE_CONTAINER_ADMIN=admin
AZURE_STORAGE_CONTAINER_VENDOR=vendor

# How long a document preview link stays valid.
AZURE_STORAGE_SAS_TTL_MINUTES=15

# Alternative to the connection string. Only needed if you prefer to keep the
# account name and key as separate settings.
# AZURE_STORAGE_ACCOUNT_NAME=bivrystorage
# AZURE_STORAGE_ACCOUNT_KEY=

MAX_UPLOAD_SIZE_MB=15

# ---------------------------------------------------------------------------
# Email
#
# Leave blank in development: reset links are printed to the server console, so
# the whole forgot password flow is testable without a mail server.
#
# REQUIRED in production, otherwise nobody can recover an account. The server
# refuses to boot in production without it. Options that work from Azure:
#   - Azure Communication Services Email (smtp.azurecomm.net, port 587)
#   - Microsoft 365 (smtp.office365.com, port 587)
#   - SendGrid, Resend, Mailgun, ...
#
# Note: outbound port 25 is blocked on Azure. Use 587 or 465.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS). Defaults from the port.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BIVRY <no-reply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Folder used by the local storage driver when Blob Storage is not configured.
UPLOAD_DIR=uploads
# Password given to every account created by `npm run db:seed`.
SEED_PASSWORD=Bivry@123
